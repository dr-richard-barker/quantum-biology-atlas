    <glyph id="GMF_REFERENCE" class="perturbing agent" compartmentRef="environment">
      <label text="Geomagnetic field" />
      <bbox x="441.86" y="0.00" w="141.27" h="34.64" />
      <glyph id="GMF_REFERENCE__u0" class="unit of information">
