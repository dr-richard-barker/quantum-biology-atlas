      <bbox x="273.95" y="285.12" w="148.99" h="47.44" />
      <glyph id="CYSTEINE_SYNTHESIS__u0" class="unit of information">
        <label text="S donor for assembly" />
        <bbox x="279.95" y="276.12" w="140.00" h="16.00" />
      </glyph>
      <extension>
        <qbo:annotation xmlns:qbo="https://dr-richard-barker.github.io/quantum-biology-atlas/qbo/1.0" entity="QBO:CYSTEINE_SYNTHESIS" evidenceTier="T4" confidence="verified">
