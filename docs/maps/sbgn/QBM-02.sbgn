    <arc id="arc7" class="consumption" source="PSI_FES" target="FERREDOXIN">
      <start x="266.39" y="376.04" />
      <end x="74.49" y="513.48" />
      <glyph id="arc7__lbl" class="annotation">
        <label text="1e−" />
