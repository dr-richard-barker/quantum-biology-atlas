          <qbo:quantumClass>structural_context</qbo:quantumClass>
          <qbo:xref db="agi">AT4G04640</qbo:xref>
          <qbo:xref db="go_component">GO:0009535</qbo:xref>
          <qbo:xref db="ec">7.1.2.2</qbo:xref>
        </qbo:annotation>
      </extension>
    </glyph>
    <glyph id="FERREDOXIN" class="macromolecule" compartmentRef="chloroplast_stroma">
      <label text="Ferredoxin" />
      <bbox x="0.00" y="489.76" w="148.99" h="47.44" />
      <glyph id="FERREDOXIN__u0" class="unit of information">
        <label text="2Fe-2S hub" />
        <bbox x="6.00" y="480.76" w="70.00" h="16.00" />
      </glyph>
      <extension>
        <qbo:annotation xmlns:qbo="https://dr-richard-barker.github.io/quantum-biology-atlas/qbo/1.0" entity="QBO:FERREDOXIN" evidenceTier="T2" confidence="reported">
          <qbo:quantumClass>iron_sulfur_2Fe2S</qbo:quantumClass>
          <qbo:nucleus>57Fe</qbo:nucleus>
          <qbo:nucleus>33S</qbo:nucleus>
          <qbo:xref db="agi">AT1G10960</qbo:xref>
          <qbo:xref db="agi">AT1G60950</qbo:xref>
          <qbo:xref db="go_component">GO:0009570</qbo:xref>
          <qbo:evidence ref="Vigani2021" doi="10.3390/ijms221810166" direction="altered" fieldRegime="NNMF">Geomagnetic field conditions modulate iron-sulfur interplay in Arabidopsis, particularly under combined iron and sulfur deficiency.
</qbo:evidence>
          <qbo:rationale>The distribution hub of plastid reducing power. A perturbation here reaches carbon fixation, nitrogen and sulfur assimilation and redox regulation at once, which is why the review nominates ferredoxin biogenesis specifically.
</qbo:rationale>
        </qbo:annotation>
      </extension>
    </glyph>
    <glyph id="FNR" class="macromolecule" compartmentRef="chloroplast_stroma">
      <label text="FNR" />
      <bbox x="182.99" y="489.76" w="148.99" h="47.44" />
      <glyph id="FNR__u0" class="unit of information">
        <label text="FAD" />
        <bbox x="188.99" y="480.76" w="30.00" h="16.00" />
      </glyph>
      <glyph id="FNR__u1" class="unit of information">
        <label text="1e− → 2e−" />
        <bbox x="188.99" y="480.76" w="63.00" h="16.00" />
      </glyph>
      <extension>
        <qbo:annotation xmlns:qbo="https://dr-richard-barker.github.io/quantum-biology-atlas/qbo/1.0" entity="QBO:FNR" evidenceTier="T3" confidence="inferred">
          <qbo:quantumClass>flavin_semiquinone</qbo:quantumClass>
          <qbo:quantumClass>ros_leak_site</qbo:quantumClass>
          <qbo:nucleus>1H</qbo:nucleus>
          <qbo:nucleus>14N</qbo:nucleus>
          <qbo:cofactor>CHEBI:57692</qbo:cofactor>
          <qbo:xref db="agi">AT5G66190</qbo:xref>
          <qbo:xref db="agi">AT1G20020</qbo:xref>
          <qbo:xref db="ec">1.18.1.2</qbo:xref>
          <qbo:rationale>FNR necessarily transits a flavin semiquinone: it is the step that converts one-electron chemistry into two-electron chemistry, so a half-reduced flavin is obligatory rather than incidental. That makes it the plastid's clearest analogue of the cryptochrome flavin.
</qbo:rationale>
        </qbo:annotation>
      </extension>
    </glyph>
