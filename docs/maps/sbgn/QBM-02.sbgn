          <qbo:xref db="agi">ATCG00720</qbo:xref>
          <qbo:xref db="go_component">GO:0009512</qbo:xref>
          <qbo:rationale>One-electron heme carriers, paramagnetic in the ferric state, adjacent to the semiquinone-generating Q cycle.
</qbo:rationale>
        </qbo:annotation>
      </extension>
    </glyph>
    <glyph id="PGR5_PGRL1" class="complex" compartmentRef="thylakoid_membrane">
