    <arc id="arc14" class="modulation" source="ACONITASE" target="GERMINATION_ATP">
      <start x="568.09" y="167.56" />
      <end x="129.56" y="311.40" />
      <glyph id="arc14__lbl" class="annotation">
        <label text="TCA flux" />
