    <glyph id="TAG_LIPASE" class="macromolecule" compartmentRef="peroxisome">
      <label text="TAG lipase (SDP1)" />
      <bbox x="86.24" y="6.40" w="139.59" h="34.64" />
      <glyph id="TAG_LIPASE__u0" class="unit of information">
