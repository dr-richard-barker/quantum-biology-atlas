    </glyph>
    <glyph id="UBISEMIQUINONE" class="simple chemical" compartmentRef="mitochondrial_inner_membrane">
      <label text="Ubisemiquinone" />
      <bbox x="291.04" y="227.68" w="127.14" h="34.64" />
      <glyph id="UBISEMIQUINONE__u0" class="unit of information">
        <label text="free radical" />
        <bbox x="297.04" y="218.68" w="84.00" h="16.00" />
      </glyph>
      <extension>
        <qbo:annotation xmlns:qbo="https://dr-richard-barker.github.io/quantum-biology-atlas/qbo/1.0" entity="QBO:UBISEMIQUINONE" evidenceTier="T3" confidence="inferred">
          <qbo:quantumClass>semiquinone_radical</qbo:quantumClass>
          <qbo:quantumClass>radical_pair_donor</qbo:quantumClass>
          <qbo:quantumClass>ros_leak_site</qbo:quantumClass>
          <qbo:nucleus>1H</qbo:nucleus>
          <qbo:xref db="chebi">CHEBI:16389</qbo:xref>
          <qbo:rationale>A free-radical intermediate held in a protein pocket. If any respiratory species supports spin-correlated chemistry, this is the leading candidate.
</qbo:rationale>
        </qbo:annotation>
      </extension>
    </glyph>
    <glyph id="AOX" class="macromolecule" compartmentRef="mitochondrial_inner_membrane">
