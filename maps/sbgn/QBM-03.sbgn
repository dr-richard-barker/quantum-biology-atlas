        </qbo:annotation>
      </extension>
    </glyph>
    <glyph id="FLOWERING_OUTPUT" class="phenotype" compartmentRef="organism">
      <label text="Flowering time (CO → FT)" />
      <bbox x="205.17" y="339.52" w="186.17" h="34.64" />
      <glyph id="FLOWERING_OUTPUT__u0" class="unit of information">
        <label text="NNMF delays this" />
        <bbox x="211.17" y="330.52" w="112.00" h="16.00" />
      </glyph>
      <extension>
        <qbo:annotation xmlns:qbo="https://dr-richard-barker.github.io/quantum-biology-atlas/qbo/1.0" entity="QBO:FLOWERING_OUTPUT" evidenceTier="T4" confidence="reported">
          <qbo:quantumClass>structural_context</qbo:quantumClass>
          <qbo:evidence ref="Agliassa2018a" doi="10.1002/bem.22123" direction="decrease" fieldRegime="NNMF">Reduction of the geomagnetic field to below 100 nT delayed Arabidopsis flowering and downregulated flowering-related genes.
</qbo:evidence>
          <qbo:evidence ref="Xu2015" doi="10.1002/bem.21927" direction="decrease" fieldRegime="NNMF">Suppression of Arabidopsis flowering by a near-null magnetic field depends on the light conditions.
</qbo:evidence>
          <qbo:evidence ref="Xu2013" doi="10.1002/bem.21788" direction="decrease" fieldRegime="NNMF">Removal of the local geomagnetic field affected reproductive growth, including silique number and seed yield.
</qbo:evidence>
        </qbo:annotation>
      </extension>
    </glyph>
